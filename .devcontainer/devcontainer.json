{
    "name": "AMBUSH Dev Container",
    "dockerComposeFile": "./docker-compose.yml",
    "service": "ambush-dev-container",
    "workspaceFolder": "/root/ambush",
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "extensions": ["golang.Go"]
        }
    },
    "postCreateCommand": "cd frontend && bun install"
}
